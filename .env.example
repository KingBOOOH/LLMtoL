# Copier en .env (qui n'est PAS versionne) et adapter si besoin.

POSTGRES_USER=llmtol
POSTGRES_PASSWORD=change_moi_en_local
POSTGRES_DB=llmtol

# Port expose sur l'hote. 5432 est pris par le backend Docker et 5433 par un Postgres
# local deja installe sur cette machine : d'ou 5442.
DB_HOST_PORT=5442

# Port de l'API, servie uniquement sur 127.0.0.1 (aucune authentification).
API_HOST_PORT=8000

# URL utilisee PAR L'AGENT, qui tourne sur l'hote et joint la base par le port publie.
# L'API, elle, est dans le reseau Docker et utilise l'hote "db" (voir docker-compose).
DATABASE_URL=postgresql+psycopg://llmtol:change_moi_en_local@127.0.0.1:5442/llmtol

# Au-dela de ce delai sans signe de vie, l'API considere qu'aucun agent n'est actif.
AGENT_TIMEOUT_S=90
