# API + interface. Ne contient NI Blender NI la bibliotheque LDraw : la generation
# tourne sur l'hote (agent.py), ce conteneur ne fait que deposer et lire des jobs.
FROM python:3.13-slim

WORKDIR /app

# psycopg[binary] evite d'avoir a installer libpq et un compilateur dans l'image.
COPY requirements-server.txt .
RUN pip install --no-cache-dir -r requirements-server.txt

COPY server/ ./server/

ENV PYTHONUNBUFFERED=1
EXPOSE 8000

CMD ["uvicorn", "server.app:app", "--host", "0.0.0.0", "--port", "8000"]
